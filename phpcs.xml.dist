<?xml version="1.0"?>
<ruleset name="WP Updates Notifier" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd">
	<description>WordPress Coding Standards for WP Updates Notifier.</description>

	<!-- p: show progress, s: show sniff codes. -->
	<arg value="ps"/>
	<arg name="basepath" value="./"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs-cache"/>

	<file>wp-updates-notifier.php</file>
	<file>includes</file>
	<file>modules</file>
	<file>uninstall.php</file>
	<file>rector.php</file>
	<file>tests</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/docker/*</exclude-pattern>

	<!-- WordPress coding standards: Core, Docs and Extra. -->
	<rule ref="WordPress"/>

	<!-- Code must run on the PHP versions we support (WordPress 6.7+ needs PHP 7.4 or newer for this plugin, see #50). -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.7"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wp-updates-notifier"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="sc_wpun"/>
				<element value="SC_WP_Updates_Notifier"/>
				<element value="SC_WPUN"/>
				<element value="WPUN"/>
			</property>
		</properties>
	</rule>

	<!--
	Exclusions. Each needs a reason.
	-->

	<!-- Test classes and test files follow PHPUnit's naming (test-*.php, Test_*), not the plugin's class-file and prefix rules. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<!-- The WordPress handbook names the file of an abstract class abstract-class-*.php; WPCS only knows class-*.php. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*/includes/abstract-class-*.php</exclude-pattern>
		<!-- The main file is named after the plugin slug and holds the compatibility class. -->
		<exclude-pattern>*/wp-updates-notifier.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- Tests build their own mail, options and requests on purpose and read and write globals the way WordPress's own tests do. -->
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.NonceVerification">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.ValidatedSanitizedInput">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
</ruleset>
