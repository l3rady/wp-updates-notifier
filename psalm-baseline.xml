<!--
	Findings of `make taint` that are proven safe. Each needs a comment saying why. The baseline may only shrink:
	never add an entry to get a build through (same rule as phpstan-baseline.neon).
-->
<files psalm-version="6.19.1@e2ca44251c1f1aa2e35452d426895746b47de64e">
  <!--
	The example channel's webhook address is a setting an administrator types in (get_option() is a source), and
	wp_safe_remote_post() refuses addresses on the server's own network unless the site allows them with core's
	http_request_host_is_external filter. Sending to an administrator's chosen URL is the channel's job.
  -->
  <file src="examples/wpun-example-channel/class-example-channel.php">
    <TaintedSSRF>
      <code><![CDATA[$url]]></code>
    </TaintedSSRF>
  </file>
  <!--
	Psalm 7 follows the address through Channel_Instance settings, which Psalm 6 did not. The Slack and webhook
	addresses are settings an administrator types in, as in the example channel above, and both are sent with
	wp_safe_remote_post(), which refuses addresses on the server's own network. Slack also allows only its own hosts.
  -->
  <file src="modules/slack/class-slack-channel.php">
    <TaintedSSRF>
      <code><![CDATA[trim( $url )]]></code>
    </TaintedSSRF>
  </file>
  <file src="modules/webhook/class-webhook-channel.php">
    <TaintedSSRF>
      <code><![CDATA[$url]]></code>
    </TaintedSSRF>
  </file>
</files>
