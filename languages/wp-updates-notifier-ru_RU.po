#, php-format
msgid "%s is defined in code and cannot be changed here."
msgstr "Канал «%s» задан в коде и не может быть изменён здесь."

msgid "Save channel"
msgstr "Сохранить канал"

msgid "There is a problem"
msgstr "Возникла проблема"

msgid "The channel was not saved. Please correct the following."
msgstr "Канал не сохранён. Исправьте следующее."

