msgid_plural "Checked just now. Sent to %1$d channels; %2$d failed: %3$s"
msgstr[0] "Проверено только что. Отправлено в %1$d канал; не удалось отправить в %2$d: %3$s"
msgstr[1] "Проверено только что. Отправлено в %1$d канала; не удалось отправить в %2$d: %3$s"
msgstr[2] "Проверено только что. Отправлено в %1$d каналов; не удалось отправить в %2$d: %3$s"

