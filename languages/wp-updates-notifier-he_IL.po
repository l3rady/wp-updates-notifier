#, php-format
msgid "%1$s cannot be switched here: set by %2$s."
msgstr "לא ניתן להפעיל או לכבות את %1$s כאן: נקבע על ידי %2$s."

#. translators: %s: Label of the channel.
#, php-format
msgid "%s enabled."
msgstr "%s הופעל."

#. translators: %s: Label of the channel.
#, php-format
