msgstr "הפעלה"

#. translators: %s: Label of the channel.
#, php-format
msgid "Delete %s"
msgstr "מחיקת %s"

msgid "Delete"
msgstr "מחיקה"

#. translators: %s: Label of the channel.
#, php-format
msgid "Delete the channel %s? Its settings and delivery history are removed. This cannot be undone."
msgstr "למחוק את הערוץ %s? ההגדרות והיסטוריית המסירה שלו יימחקו. לא ניתן לבטל פעולה זו."

msgid "No known item types"
msgstr "אין סוגי פריטים מוכרים"

msgid "All updates"
msgstr "כל העדכונים"

msgid "Never"
msgstr "אף פעם"

