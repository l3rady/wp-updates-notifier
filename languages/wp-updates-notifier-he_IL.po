msgstr "%s (עותק)"

#. translators: %s: Label of the new channel.
#, php-format
msgid "Channel duplicated as %s."
msgstr "הערוץ שוכפל בשם %s."

#. translators: %s: Label of the channel.
#, php-format
msgid "%s deleted."
msgstr "%s נמחק."

msgid "Check for updates and notify now"
msgstr "לבדוק עדכונים ולהודיע עכשיו"

#. translators: %s: Link to the Channels tab, with the text "Channels tab".
#, php-format
msgid "Only updates that were not notified yet are sent. To try a channel, send a test message from the %s."
msgstr "יישלחו רק עדכונים שעדיין לא נשלחה עליהם הודעה. כדי לנסות ערוץ, אפשר לשלוח הודעת בדיקה מ%s."

msgid "Channels tab"
msgstr "לשונית הערוצים"

msgid "Checked just now. Nothing was sent because no channel is enabled."
msgstr "נבדק זה עתה. לא נשלח דבר כי אף ערוץ אינו מופעל."

msgid "Checked just now. Nothing new to send."
msgstr "נבדק זה עתה. אין שום דבר חדש לשלוח."

#. translators: %d: Number of channels the update was sent to.
#, php-format
msgid "Checked just now. Sent to %d channel."
msgid_plural "Checked just now. Sent to %d channels."
msgstr[0] "נבדק זה עתה. נשלח ל-%d ערוץ."
msgstr[1] "נבדק זה עתה. נשלח ל-%d ערוצים."

#. translators: 1: Number of channels that failed. 2: The channels and why each failed.
#, php-format
msgid "Checked just now. %1$d channel failed: %2$s"
msgid_plural "Checked just now. %1$d channels failed: %2$s"
msgstr[0] "נבדק זה עתה. %1$d ערוץ נכשל: %2$s"
msgstr[1] "נבדק זה עתה. %1$d ערוצים נכשלו: %2$s"

#. translators: 1: Number of channels the update was sent to. 2: Number of channels that failed. 3: The channels that failed and why.
#, php-format
msgid "Checked just now. Sent to %1$d channel; %2$d failed: %3$s"
msgid_plural "Checked just now. Sent to %1$d channels; %2$d failed: %3$s"
msgstr[0] "נבדק זה עתה. נשלח ל-%1$d ערוץ; %2$d נכשלו: %3$s"
msgstr[1] "נבדק זה עתה. נשלח ל-%1$d ערוצים; %2$d נכשלו: %3$s"

msgid "Error:"
msgstr "שגיאה:"

msgid "Clear the saved value"
msgstr "ניקוי הערך השמור"

#. translators: %s: Label of the field, for example "Webhook URL".
#, php-format
msgid "Clear the saved value of %s"
msgstr "ניקוי הערך השמור של %s"

msgid "A value is saved. Leave this empty to keep it, or type a new value to replace it."
msgstr "קיים ערך שמור. יש להשאיר את השדה ריק כדי לשמור עליו, או להקליד ערך חדש כדי להחליף אותו."

#. translators: Shown after the label of a field that must be filled in.
msgid "(required)"
msgstr "(חובה)"

#. translators: %s: the API requirement an add-on declared, as written in its plugin header.
#, php-format
msgid "This add-on's WP Updates Notifier API requirement (%s) could not be read."
msgstr "לא ניתן היה לקרוא את דרישת ה-API של WP Updates Notifier בתוסף ההרחבה הזה (%s)."

#. translators: 1: the API version an add-on needs, as a constraint such as ^2.0. 2: the API version of this site, such as 1.0.0.
#, php-format
msgid "This add-on needs the WP Updates Notifier API %1$s. This site has %2$s. Update WP Updates Notifier."
msgstr "תוסף ההרחבה הזה דורש את ה-API של WP Updates Notifier בגרסה %1$s. באתר זה מותקנת %2$s. יש לעדכן את WP Updates Notifier."

msgid "Updates Notifier"
msgstr "Updates Notifier"

#. translators: 1: Name of the view, for example "Channels". 2: Title of the screen and site.
#, php-format
msgid "%1$s &lsaquo; %2$s"
msgstr "%1$s &lsaquo; %2$s"

#. translators: %s: Page title.
#, php-format
msgid "Error: %s"
msgstr "שגיאה: %s"

msgid "General"
msgstr "כללי"

msgid "About"
msgstr "אודות"

msgid "Sorry, you are not allowed to access this page."
msgstr "אין לך הרשאות לגשת לעמוד זה."

msgid "Settings sections"
msgstr "אזורי הגדרות"

msgid "Last checked: never"
msgstr "בדיקה אחרונה: אף פעם"

#. translators: %s: Date and time of the last check.
#, php-format
msgid "Last checked: %s"
msgstr "בדיקה אחרונה: %s"

msgid "Next check: not scheduled. Save the settings to schedule it."
msgstr "הבדיקה הבאה: לא מתוזמנת. יש לשמור את ההגדרות כדי לתזמן אותה."

#. translators: %s: Date and time of the next check.
#, php-format
msgid "Next check: %s"
msgstr "הבדיקה הבאה: %s"

msgid "Save settings"
msgstr "שמירת הגדרות"

#. translators: 1: Date. 2: Time.
#, php-format
msgid "%1$s at %2$s"
msgstr "%1$s בשעה %2$s"

msgid "Choose how often to check for updates."
msgstr "יש לבחור באיזו תדירות לבדוק אם יש עדכונים."

msgid "Choose whether to be told about WordPress updates."
msgstr "יש לבחור אם לקבל הודעות על עדכוני WordPress."

msgid "Choose whether to be told about plugin updates."
msgstr "יש לבחור אם לקבל הודעות על עדכוני תוספים."

msgid "Choose whether to be told about theme updates."
msgstr "יש לבחור אם לקבל הודעות על עדכוני ערכות עיצוב."

msgid "Choose whether to hide the update notices."
msgstr "יש לבחור אם להסתיר את הודעות העדכון."

#. translators: %s: Label of the setting.
#, php-format
msgid "Choose a value for %s."
msgstr "יש לבחור ערך עבור %s."

msgid "This is a test message from WP Updates Notifier."
msgstr "זוהי הודעת בדיקה מ-WP Updates Notifier."

#. translators: %s: Name of the saved schedule.
#, php-format
msgid "%s (no longer available)"
msgstr "%s (כבר לא זמין)"

msgid "The saved frequency is no longer available on this site, so checks run at the interval they were last scheduled with. Choose a frequency and save to change it."
msgstr "התדירות השמורה כבר לא זמינה באתר זה, ולכן הבדיקות רצות במרווח שבו תוזמנו לאחרונה. כדי לשנות זאת, יש לבחור תדירות ולשמור."

#. translators: 1: The display asked for. 2: The display used instead.
#, php-format
msgid "The display \"%1$s\" cannot show an on or off value, so \"%2$s\" is used."
msgstr "התצוגה \"%1$s\" לא יכולה להציג ערך של פועל או כבוי, ולכן נעשה שימוש ב-\"%2$s\"."

msgid "Yes"
msgstr "כן"

msgid "No"
msgstr "לא"

msgid "A channel type may only contain lower case letters, digits and underscores."
msgstr "סוג ערוץ יכול להכיל רק אותיות לטיניות קטנות, ספרות וקווים תחתונים."

#. translators: %s: Channel type.
#, php-format
msgid "A channel of type \"%s\" is already registered."
msgstr "ערוץ מסוג \"%s\" כבר רשום."

