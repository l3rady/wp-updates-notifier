msgstr "אין לך הרשאה לבצע פעולה זו."

#. translators: %s: Label of the channel.
#, php-format
msgid "Delete %s?"
msgstr "למחוק את %s?"

msgid "Channels"
msgstr "ערוצים"

msgid "No channels are set up yet. A channel is where the update notifications are sent, for example an email address."
msgstr "עדיין לא הוגדרו ערוצים. ערוץ הוא היעד שאליו נשלחות ההודעות על עדכונים, למשל כתובת אימייל."

msgid "Module"
msgstr "מודול"

msgid "Last delivery"
msgstr "מסירה אחרונה"

msgid "Unavailable channels"
msgstr "ערוצים לא זמינים"

msgid "These channels belong to modules that need a newer version of WP Updates Notifier. Nothing is sent through them and their settings are kept."
msgstr "ערוצים אלה שייכים למודולים שדורשים גרסה חדשה יותר של WP Updates Notifier. דרכם לא נשלח דבר, וההגדרות שלהם נשמרות."

msgid "Status"
msgstr "סטטוס"

