msgstr "%1$s om %2$s"

msgid "Choose how often to check for updates."
msgstr "Kies hoe vaak er op updates gecontroleerd wordt."

msgid "Choose whether to be told about WordPress updates."
msgstr "Kies of je over WordPress-updates geïnformeerd wilt worden."

msgid "Choose whether to be told about plugin updates."
msgstr "Kies of je over plugin-updates geïnformeerd wilt worden."

msgid "Choose whether to be told about theme updates."
msgstr "Kies of je over thema-updates geïnformeerd wilt worden."

msgid "Choose whether to hide the update notices."
msgstr "Kies of de updatemeldingen verborgen worden."

