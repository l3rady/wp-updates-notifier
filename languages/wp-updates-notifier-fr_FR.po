msgstr "Module"

msgid "Last delivery"
msgstr "Dernier envoi"

msgid "Unavailable channels"
msgstr "Canaux indisponibles"

msgid "These channels belong to modules that need a newer version of WP Updates Notifier. Nothing is sent through them and their settings are kept."
msgstr "Ces canaux appartiennent à des modules qui nécessitent une version plus récente de WP Updates Notifier. Rien n’est envoyé par leur biais et leurs réglages sont conservés."

msgid "Status"
msgstr "État"

