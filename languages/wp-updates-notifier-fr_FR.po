msgstr "%1$s &lsaquo; %2$s"

#. translators: %s: Page title.
#, php-format
msgid "Error: %s"
msgstr "Erreur : %s"

msgid "General"
msgstr "Général"

msgid "About"
msgstr "À propos"

msgid "Sorry, you are not allowed to access this page."
msgstr "Désolé, vous n’avez pas l’autorisation d’accéder à cette page."

msgid "Settings sections"
msgstr "Sections des réglages"

msgid "Last checked: never"
msgstr "Dernière vérification : jamais"

#. translators: %s: Date and time of the last check.
#, php-format
msgid "Last checked: %s"
msgstr "Dernière vérification : %s"

msgid "Next check: not scheduled. Save the settings to schedule it."
msgstr "Prochaine vérification : non planifiée. Enregistrez les réglages pour la planifier."

#. translators: %s: Date and time of the next check.
#, php-format
msgid "Next check: %s"
msgstr "Prochaine vérification : %s"

msgid "Save settings"
msgstr "Enregistrer les réglages"

#. translators: 1: Date. 2: Time.
#, php-format
msgid "%1$s at %2$s"
msgstr "%1$s à %2$s"

msgid "Choose how often to check for updates."
msgstr "Choisissez la fréquence de recherche des mises à jour."

msgid "Choose whether to be told about WordPress updates."
msgstr "Choisissez si vous voulez être averti des mises à jour de WordPress."

msgid "Choose whether to be told about plugin updates."
msgstr "Choisissez si vous voulez être averti des mises à jour des extensions."

msgid "Choose whether to be told about theme updates."
msgstr "Choisissez si vous voulez être averti des mises à jour des thèmes."

msgid "Choose whether to hide the update notices."
msgstr "Choisissez si vous voulez masquer les avis de mise à jour."

#. translators: %s: Label of the setting.
#, php-format
msgid "Choose a value for %s."
msgstr "Choisissez une valeur pour %s."

msgid "This is a test message from WP Updates Notifier."
msgstr "Ceci est un message de test de WP Updates Notifier."

#. translators: %s: Name of the saved schedule.
#, php-format
msgid "%s (no longer available)"
msgstr "%s (plus disponible)"

msgid "The saved frequency is no longer available on this site, so checks run at the interval they were last scheduled with. Choose a frequency and save to change it."
msgstr "La fréquence enregistrée n’est plus disponible sur ce site, les vérifications ont donc lieu à l’intervalle avec lequel elles ont été planifiées pour la dernière fois. Choisissez une fréquence et enregistrez pour la modifier."

#. translators: 1: The display asked for. 2: The display used instead.
#, php-format
msgid "The display \"%1$s\" cannot show an on or off value, so \"%2$s\" is used."
msgstr "L’affichage « %1$s » ne peut pas montrer une valeur activée ou désactivée, « %2$s » est donc utilisé."

msgid "Yes"
msgstr "Oui"

msgid "No"
msgstr "Non"

msgid "A channel type may only contain lower case letters, digits and underscores."
msgstr "Un type de canal ne peut contenir que des lettres minuscules, des chiffres et des tirets bas."

#. translators: %s: Channel type.
#, php-format
msgid "A channel of type \"%s\" is already registered."
msgstr "Un canal de type « %s » est déjà enregistré."

#. translators: 1: The API version constraint the module needs, 2: The API version of this site.
#, php-format
msgid "Needs WP Updates Notifier API %1$s; this site has %2$s. Update WP Updates Notifier."
msgstr "Nécessite l’API WP Updates Notifier %1$s ; ce site dispose de la version %2$s. Mettez à jour WP Updates Notifier."

#. translators: %s: The API version constraint the module declared.
#, php-format
msgid "Its API requirement \"%s\" could not be read."
msgstr "Son exigence d’API « %s » n’a pas pu être lue."

msgid "An instance defined in code cannot be saved."
msgstr "Une instance définie dans le code ne peut pas être enregistrée."

msgid "An instance defined in code cannot be deleted."
msgstr "Une instance définie dans le code ne peut pas être supprimée."

#. translators: 1: Channel type. 2: Field name.
#, php-format
msgid "The field \"%2$s\" of the \"%1$s\" channel cannot be supplied from outside the database: the name \"enabled\" is reserved, and names may only contain a-z, 0-9 and single underscores."
msgstr "Le champ « %2$s » du canal « %1$s » ne peut pas être fourni depuis l’extérieur de la base de données : le nom « enabled » est réservé, et les noms ne peuvent contenir que a-z, 0-9 et des tirets bas isolés."

msgid "The value is not valid for this channel."
msgstr "La valeur n’est pas valide pour ce canal."

#. translators: %s: Class name of an exception.
#, php-format
msgid "The value could not be checked: %s was thrown."
msgstr "La valeur n’a pas pu être vérifiée : une exception %s a été levée."

#. translators: Describes where a configuration value comes from; shown in "Set by %s". Keep SC_WPUN_CHANNELS as is.
msgid "constant SC_WPUN_CHANNELS"
msgstr "la constante SC_WPUN_CHANNELS"

msgid "The constant must be a JSON string."
msgstr "La constante doit être une chaîne JSON."

msgid "The value must be a JSON string."
msgstr "La valeur doit être une chaîne JSON."

msgid "The JSON must be a list of channels."
msgstr "Le JSON doit être une liste de canaux."

#. translators: Describes where a configuration value comes from; shown in "Set by %s". Keep sc_wpun_channels as is.
msgid "the sc_wpun_channels filter"
msgstr "le filtre sc_wpun_channels"

#. translators: %d: Position of the entry in the list, starting at 1.
#, php-format
msgid "Channel %d repeats the id of an earlier channel and was skipped."
msgstr "Le canal %d reprend l’ID d’un canal précédent et a été ignoré."

#. translators: %d: Position of the entry in the list, starting at 1.
#, php-format
msgid "Channel %d is not valid and was skipped."
msgstr "Le canal %d n’est pas valide et a été ignoré."

msgid "Some configuration values supplied from outside the database are not valid. Invalid settings fall back to the saved value; a channel with an invalid value does not send until it is fixed."
msgstr "Certaines valeurs de configuration fournies depuis l’extérieur de la base de données ne sont pas valides. Les réglages non valides reviennent à la valeur enregistrée ; un canal avec une valeur non valide n’envoie rien tant qu’elle n’est pas corrigée."

msgid "WP Updates Notifier cannot use some configuration values"
msgstr "WP Updates Notifier ne peut pas utiliser certaines valeurs de configuration"

msgid "Some values supplied by constants, environment variables or other sources are not valid. Invalid settings fall back to the saved value; a channel with an invalid value does not send until it is fixed."
msgstr "Certaines valeurs fournies par des constantes, des variables d’environnement ou d’autres sources ne sont pas valides. Les réglages non valides reviennent à la valeur enregistrée ; un canal avec une valeur non valide n’envoie rien tant qu’elle n’est pas corrigée."

msgid "Review the notification settings"
msgstr "Vérifier les réglages de notification"

#. translators: Describes where a configuration value comes from; shown in "Set by %s". Keep sc_wpun_config_value as is.
msgid "the sc_wpun_config_value filter"
msgstr "le filtre sc_wpun_config_value"

msgid "The value is not valid for this setting, so the default is used."
msgstr "La valeur n’est pas valide pour ce réglage, la valeur par défaut est donc utilisée."

msgid "The value is not valid for this setting, so the saved one is used."
msgstr "La valeur n’est pas valide pour ce réglage, la valeur enregistrée est donc utilisée."

msgid "The value is not valid for this field."
msgstr "La valeur n’est pas valide pour ce champ."

msgid "The value is not a recognised on or off value (1, true, yes, on, 0, false, no, off), so environment variables are not read."
msgstr "La valeur n’est pas une valeur d’activation ou de désactivation reconnue (1, true, yes, on, 0, false, no, off), les variables d’environnement ne sont donc pas lues."

msgid "Every entry must implement WPUN\\Config_Source."
msgstr "Chaque entrée doit implémenter WPUN\\Config_Source."

#. translators: Describes where a configuration value comes from; shown in "Set by %s".
msgid "a configuration source"
msgstr "une source de configuration"

#. translators: %s: Name of a PHP constant. Describes where a configuration value comes from; shown in "Set by %s".
#, php-format
msgid "constant %s"
msgstr "la constante %s"

msgid "This channel is switched off."
msgstr "Ce canal est désactivé."

#. translators: %s: Channel type.
#, php-format
msgid "The \"%s\" channel did not return a Delivery_Result."
