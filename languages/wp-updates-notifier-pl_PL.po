msgstr "Dodaj kanał: %s"

#. translators: %s: Label of the channel.
#, php-format
msgid "Edit %s"
msgstr "Edytuj „%s”"

msgid "There is no such channel module."
msgstr "Taki moduł kanału nie istnieje."

msgid "There is no such channel."
msgstr "Taki kanał nie istnieje."

