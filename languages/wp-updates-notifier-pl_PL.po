msgstr[0] "Sprawdzono przed chwilą. Błąd w %1$d kanale: %2$s"
msgstr[1] "Sprawdzono przed chwilą. Błąd w %1$d kanałach: %2$s"
msgstr[2] "Sprawdzono przed chwilą. Błąd w %1$d kanałach: %2$s"

#. translators: 1: Number of channels the update was sent to. 2: Number of channels that failed. 3: The channels that failed and why.
#, php-format
msgid "Checked just now. Sent to %1$d channel; %2$d failed: %3$s"
msgid_plural "Checked just now. Sent to %1$d channels; %2$d failed: %3$s"
msgstr[0] "Sprawdzono przed chwilą. Wysłano do %1$d kanału; nie udało się wysłać do %2$d: %3$s"
msgstr[1] "Sprawdzono przed chwilą. Wysłano do %1$d kanałów; nie udało się wysłać do %2$d: %3$s"
msgstr[2] "Sprawdzono przed chwilą. Wysłano do %1$d kanałów; nie udało się wysłać do %2$d: %3$s"

