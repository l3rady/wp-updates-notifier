#, php-format
msgid "%s is defined in code and cannot be changed here."
msgstr "Kanał „%s” jest zdefiniowany w kodzie i nie można go tu zmienić."

msgid "Save channel"
msgstr "Zapisz kanał"

msgid "There is a problem"
msgstr "Wystąpił problem"

msgid "The channel was not saved. Please correct the following."
msgstr "Kanał nie został zapisany. Popraw poniższe błędy."

#. translators: %s: Where the value comes from, for example "constant SC_WPUN_SETTING_FREQUENCY".
#, php-format
msgid "Set by %s"
msgstr "Źródło: %s"

msgid "Channel"
msgstr "Kanał"

msgid "ID"
msgstr "ID"

msgid "The id is made from the label when the channel is saved and cannot be changed afterwards."
msgstr "ID jest tworzony z nazwy podczas zapisywania kanału i nie można go później zmienić."

#. translators: %s: Start of the names of the constants, for example "SC_WPUN_CHANNEL_EMAIL__".
#, php-format
msgid "Constants for this channel start with %s"
msgstr "Stałe tego kanału zaczynają się od %s"

msgid "Updates already waiting"
msgstr "Oczekujące aktualizacje"

msgid "Don't send the updates that are already waiting"
msgstr "Nie wysyłaj aktualizacji, które już oczekują"

msgid "Only updates that appear after the channel is switched on are sent. Applies when the channel is saved switched on."
msgstr "Wysyłane są tylko aktualizacje, które pojawią się po włączeniu kanału. Ma zastosowanie, gdy kanał zostanie zapisany jako włączony."

msgid "Routing"
msgstr "Kierowanie"

msgid "On the General tab, plugins are not checked."
msgstr "Na karcie „Ogólne” sprawdzanie wtyczek jest wyłączone."

#. translators: "All" and "Only active ones" are routing choices on this form: use the same translations as for those choices.
msgid "On the General tab, only active plugins are checked, so \"All\" here acts like \"Only active ones\" for plugins."
msgstr "Na karcie „Ogólne” sprawdzane są tylko aktywne wtyczki, więc opcja „Wszystkie” działa tu dla wtyczek jak „Tylko aktywne”."

msgid "On the General tab, themes are not checked."
msgstr "Na karcie „Ogólne” sprawdzanie motywów jest wyłączone."

#. translators: "All" and "Only active ones" are routing choices on this form: use the same translations as for those choices.
msgid "On the General tab, only active themes are checked, so \"All\" here acts like \"Only active ones\" for themes."
msgstr "Na karcie „Ogólne” sprawdzane są tylko aktywne motywy, więc opcja „Wszystkie” działa tu dla motywów jak „Tylko aktywne”."

msgid "On the General tab, WordPress updates are not checked."
msgstr "Na karcie „Ogólne” sprawdzanie aktualizacji WordPressa jest wyłączone."

msgid "On the General tab, only major releases are checked."
msgstr "Na karcie „Ogólne” sprawdzane są tylko główne wydania."

msgid "Settings"
msgstr "Ustawienia"

msgid "Label"
msgstr "Nazwa"

msgid "The settings are not valid."
msgstr "Ustawienia są nieprawidłowe."

