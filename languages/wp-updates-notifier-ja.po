#, php-format
msgid "The test message could not be sent through %1$s: %2$s"
msgstr "%1$s でテストメッセージを送信できませんでした: %2$s"

#. translators: 1: Label of the channel. 2: Where the value comes from, for example "constant SC_WPUN_CHANNEL_EMAIL__ENABLED".
#, php-format
msgid "%1$s cannot be switched here: set by %2$s."
msgstr "%1$s はここでは切り替えられません: %2$s で設定されています。"

#. translators: %s: Label of the channel.
#, php-format
msgid "%s enabled."
msgstr "%s を有効化しました。"

#. translators: %s: Label of the channel.
#, php-format
msgid "%s disabled."
msgstr "%s を無効化しました。"

#. translators: %s: Label of the channel that is copied.
#, php-format
msgid "%s (copy)"
msgstr "%s (コピー)"

#. translators: %s: Label of the new channel.
#, php-format
msgid "Channel duplicated as %s."
msgstr "チャンネルを %s として複製しました。"

#. translators: %s: Label of the channel.
#, php-format
msgid "%s deleted."
msgstr "%s を削除しました。"

msgid "Check for updates and notify now"
msgstr "今すぐ更新を確認して通知"

#. translators: %s: Link to the Channels tab, with the text "Channels tab".
#, php-format
msgid "Only updates that were not notified yet are sent. To try a channel, send a test message from the %s."
msgstr "まだ通知されていない更新のみを送信します。チャンネルを試すには、%sからテストメッセージを送信してください。"

msgid "Channels tab"
msgstr "「チャンネル」タブ"

msgid "Checked just now. Nothing was sent because no channel is enabled."
msgstr "確認しました。有効なチャンネルがないため、何も送信されませんでした。"

msgid "Checked just now. Nothing new to send."
msgstr "確認しました。新しく送信するものはありません。"

#. translators: %d: Number of channels the update was sent to.
#, php-format
msgid "Checked just now. Sent to %d channel."
msgid_plural "Checked just now. Sent to %d channels."
msgstr[0] "確認しました。%d件のチャンネルに送信しました。"

#. translators: 1: Number of channels that failed. 2: The channels and why each failed.
#, php-format
msgid "Checked just now. %1$d channel failed: %2$s"
msgid_plural "Checked just now. %1$d channels failed: %2$s"
msgstr[0] "確認しました。%1$d件のチャンネルで失敗しました: %2$s"

#. translators: 1: Number of channels the update was sent to. 2: Number of channels that failed. 3: The channels that failed and why.
#, php-format
msgid "Checked just now. Sent to %1$d channel; %2$d failed: %3$s"
msgid_plural "Checked just now. Sent to %1$d channels; %2$d failed: %3$s"
msgstr[0] "確認しました。%1$d件のチャンネルに送信し、%2$d件で失敗しました: %3$s"

msgid "Error:"
msgstr "エラー:"

msgid "Clear the saved value"
msgstr "保存された値を消去"

#. translators: %s: Label of the field, for example "Webhook URL".
#, php-format
msgid "Clear the saved value of %s"
msgstr "%s の保存された値を消去"

msgid "A value is saved. Leave this empty to keep it, or type a new value to replace it."
msgstr "値が保存されています。そのままにする場合は空欄のままにし、置き換える場合は新しい値を入力してください。"

#. translators: Shown after the label of a field that must be filled in.
msgid "(required)"
msgstr "(必須)"

#. translators: %s: the API requirement an add-on declared, as written in its plugin header.
#, php-format
msgid "This add-on's WP Updates Notifier API requirement (%s) could not be read."
msgstr "このアドオンの WP Updates Notifier API 要件 (%s) を読み取れませんでした。"

#. translators: 1: the API version an add-on needs, as a constraint such as ^2.0. 2: the API version of this site, such as 1.0.0.
#, php-format
msgid "This add-on needs the WP Updates Notifier API %1$s. This site has %2$s. Update WP Updates Notifier."
msgstr "このアドオンには WP Updates Notifier API %1$s が必要です。このサイトは %2$s です。WP Updates Notifier を更新してください。"

msgid "Updates Notifier"
msgstr "Updates Notifier"

#. translators: 1: Name of the view, for example "Channels". 2: Title of the screen and site.
#, php-format
msgid "%1$s &lsaquo; %2$s"
msgstr "%1$s &lsaquo; %2$s"

