msgstr "%1$s に失敗: %2$s"

#. translators: %s: Date and time the channel will be tried again.
#, php-format
msgid "Rate limited, next try after %s"
msgstr "レート制限中。次回の試行は %s 以降"

#. translators: %s: Label of the channel.
#, php-format
msgid "%s cannot send a test message."
msgstr "%s はテストメッセージを送信できません。"

#. translators: %s: Name of the channel.
#, php-format
msgid "Test message sent through %s."
msgstr "%s でテストメッセージを送信しました。"

