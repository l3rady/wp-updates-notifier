msgstr "削除"

#. translators: %s: Label of the channel.
#, php-format
msgid "Delete the channel %s? Its settings and delivery history are removed. This cannot be undone."
msgstr "チャンネル %s を削除しますか ? 設定と配信履歴も削除されます。この操作は取り消せません。"

msgid "No known item types"
msgstr "既知の項目タイプがありません"

msgid "All updates"
msgstr "すべての更新"

msgid "Never"
msgstr "なし"

#. translators: %s: Date and time of the delivery.
#, php-format
msgid "Sent %s"
msgstr "%s に送信"

