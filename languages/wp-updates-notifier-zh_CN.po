#, php-format
msgid "Delete %s?"
msgstr "删除%s？"

msgid "Channels"
msgstr "渠道"

msgid "No channels are set up yet. A channel is where the update notifications are sent, for example an email address."
msgstr "尚未设置任何渠道。渠道是更新通知的发送目标，例如一个电子邮件地址。"

msgid "Module"
msgstr "模块"

msgid "Last delivery"
msgstr "上次发送"

msgid "Unavailable channels"
msgstr "不可用的渠道"

msgid "These channels belong to modules that need a newer version of WP Updates Notifier. Nothing is sent through them and their settings are kept."
msgstr "这些渠道所属的模块需要更新版本的 WP Updates Notifier。不会通过它们发送任何内容，其设置将被保留。"

msgid "Status"
msgstr "状态"

#. translators: %s: Why the module is not available.
#, php-format
msgid "Unavailable: %s"
msgstr "不可用：%s"

