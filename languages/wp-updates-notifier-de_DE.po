msgid_plural "Checked just now. Sent to %d channels."
msgstr[0] "Gerade geprüft. An %d Kanal gesendet."
msgstr[1] "Gerade geprüft. An %d Kanäle gesendet."

#. translators: 1: Number of channels that failed. 2: The channels and why each failed.
#, php-format
msgid "Checked just now. %1$d channel failed: %2$s"
msgid_plural "Checked just now. %1$d channels failed: %2$s"
msgstr[0] "Gerade geprüft. %1$d Kanal fehlgeschlagen: %2$s"
msgstr[1] "Gerade geprüft. %1$d Kanäle fehlgeschlagen: %2$s"

#. translators: 1: Number of channels the update was sent to. 2: Number of channels that failed. 3: The channels that failed and why.
#, php-format
msgid "Checked just now. Sent to %1$d channel; %2$d failed: %3$s"
msgid_plural "Checked just now. Sent to %1$d channels; %2$d failed: %3$s"
msgstr[0] "Gerade geprüft. An %1$d Kanal gesendet; %2$d fehlgeschlagen: %3$s"
msgstr[1] "Gerade geprüft. An %1$d Kanäle gesendet; %2$d fehlgeschlagen: %3$s"

msgid "Error:"
msgstr "Fehler:"

msgid "Clear the saved value"
msgstr "Gespeicherten Wert löschen"

#. translators: %s: Label of the field, for example "Webhook URL".
#, php-format
msgid "Clear the saved value of %s"
msgstr "Gespeicherten Wert von %s löschen"

msgid "A value is saved. Leave this empty to keep it, or type a new value to replace it."
msgstr "Es ist ein Wert gespeichert. Lass das Feld leer, um ihn zu behalten, oder gib einen neuen Wert ein, um ihn zu ersetzen."

#. translators: Shown after the label of a field that must be filled in.
msgid "(required)"
msgstr "(erforderlich)"

#. translators: %s: the API requirement an add-on declared, as written in its plugin header.
#, php-format
msgid "This add-on's WP Updates Notifier API requirement (%s) could not be read."
msgstr "Die Anforderung dieses Add-ons an die API von WP Updates Notifier (%s) konnte nicht gelesen werden."

#. translators: 1: the API version an add-on needs, as a constraint such as ^2.0. 2: the API version of this site, such as 1.0.0.
#, php-format
msgid "This add-on needs the WP Updates Notifier API %1$s. This site has %2$s. Update WP Updates Notifier."
msgstr "Dieses Add-on benötigt die API %1$s von WP Updates Notifier. Diese Website hat %2$s. Aktualisiere WP Updates Notifier."

msgid "Updates Notifier"
msgstr "Updates Notifier"

#. translators: 1: Name of the view, for example "Channels". 2: Title of the screen and site.
#, php-format
msgid "%1$s &lsaquo; %2$s"
msgstr "%1$s &lsaquo; %2$s"

#. translators: %s: Page title.
#, php-format
msgid "Error: %s"
msgstr "Fehler: %s"

msgid "General"
msgstr "Allgemein"

msgid "About"
msgstr "Über"

msgid "Sorry, you are not allowed to access this page."
msgstr "Du hast leider keine Berechtigung, auf diese Seite zuzugreifen."

msgid "Settings sections"
msgstr "Einstellungsbereiche"

msgid "Last checked: never"
msgstr "Zuletzt geprüft: nie"

#. translators: %s: Date and time of the last check.
#, php-format
msgid "Last checked: %s"
msgstr "Zuletzt geprüft: %s"

msgid "Next check: not scheduled. Save the settings to schedule it."
msgstr "Nächste Prüfung: nicht geplant. Speichere die Einstellungen, um sie zu planen."

#. translators: %s: Date and time of the next check.
#, php-format
msgid "Next check: %s"
msgstr "Nächste Prüfung: %s"

msgid "Save settings"
msgstr "Einstellungen speichern"

#. translators: 1: Date. 2: Time.
#, php-format
msgid "%1$s at %2$s"
msgstr "%1$s um %2$s"

msgid "Choose how often to check for updates."
msgstr "Wähle aus, wie oft nach Aktualisierungen gesucht werden soll."

msgid "Choose whether to be told about WordPress updates."
msgstr "Wähle aus, ob du über WordPress-Aktualisierungen informiert werden möchtest."

msgid "Choose whether to be told about plugin updates."
msgstr "Wähle aus, ob du über Plugin-Aktualisierungen informiert werden möchtest."

msgid "Choose whether to be told about theme updates."
msgstr "Wähle aus, ob du über Theme-Aktualisierungen informiert werden möchtest."

msgid "Choose whether to hide the update notices."
msgstr "Wähle aus, ob die Aktualisierungshinweise ausgeblendet werden sollen."

#. translators: %s: Label of the setting.
#, php-format
msgid "Choose a value for %s."
msgstr "Wähle einen Wert für %s."

msgid "This is a test message from WP Updates Notifier."
msgstr "Dies ist eine Testnachricht von WP Updates Notifier."

#. translators: %s: Name of the saved schedule.
#, php-format
msgid "%s (no longer available)"
msgstr "%s (nicht mehr verfügbar)"

msgid "The saved frequency is no longer available on this site, so checks run at the interval they were last scheduled with. Choose a frequency and save to change it."
msgstr "Die gespeicherte Häufigkeit ist auf dieser Website nicht mehr verfügbar, daher laufen die Prüfungen in dem Intervall, mit dem sie zuletzt geplant wurden. Wähle eine Häufigkeit und speichere, um das zu ändern."

#. translators: 1: The display asked for. 2: The display used instead.
#, php-format
msgid "The display \"%1$s\" cannot show an on or off value, so \"%2$s\" is used."
msgstr "Die Darstellung „%1$s“ kann keinen An/Aus-Wert anzeigen, daher wird „%2$s“ verwendet."

msgid "Yes"
msgstr "Ja"

msgid "No"
msgstr "Nein"

msgid "A channel type may only contain lower case letters, digits and underscores."
msgstr "Ein Kanaltyp darf nur Kleinbuchstaben, Ziffern und Unterstriche enthalten."

#. translators: %s: Channel type.
#, php-format
msgid "A channel of type \"%s\" is already registered."
msgstr "Ein Kanal vom Typ „%s“ ist bereits registriert."

#. translators: 1: The API version constraint the module needs, 2: The API version of this site.
#, php-format
msgid "Needs WP Updates Notifier API %1$s; this site has %2$s. Update WP Updates Notifier."
msgstr "Benötigt die API %1$s von WP Updates Notifier; diese Website hat %2$s. Aktualisiere WP Updates Notifier."

#. translators: %s: The API version constraint the module declared.
#, php-format
msgid "Its API requirement \"%s\" could not be read."
msgstr "Seine API-Anforderung „%s“ konnte nicht gelesen werden."

msgid "An instance defined in code cannot be saved."
msgstr "Eine im Code definierte Instanz kann nicht gespeichert werden."

msgid "An instance defined in code cannot be deleted."
msgstr "Eine im Code definierte Instanz kann nicht gelöscht werden."

#. translators: 1: Channel type. 2: Field name.
#, php-format
msgid "The field \"%2$s\" of the \"%1$s\" channel cannot be supplied from outside the database: the name \"enabled\" is reserved, and names may only contain a-z, 0-9 and single underscores."
msgstr "Das Feld „%2$s“ des Kanals „%1$s“ kann nicht von außerhalb der Datenbank bereitgestellt werden: Der Name „enabled“ ist reserviert, und Namen dürfen nur a-z, 0-9 und einzelne Unterstriche enthalten."

msgid "The value is not valid for this channel."
msgstr "Der Wert ist für diesen Kanal ungültig."

#. translators: %s: Class name of an exception.
#, php-format
msgid "The value could not be checked: %s was thrown."
msgstr "Der Wert konnte nicht geprüft werden: %s wurde ausgelöst."

#. translators: Describes where a configuration value comes from; shown in "Set by %s". Keep SC_WPUN_CHANNELS as is.
msgid "constant SC_WPUN_CHANNELS"
msgstr "die Konstante SC_WPUN_CHANNELS"

msgid "The constant must be a JSON string."
msgstr "Die Konstante muss ein JSON-String sein."

msgid "The value must be a JSON string."
msgstr "Der Wert muss ein JSON-String sein."

msgid "The JSON must be a list of channels."
msgstr "Das JSON muss eine Liste von Kanälen sein."

#. translators: Describes where a configuration value comes from; shown in "Set by %s". Keep sc_wpun_channels as is.
msgid "the sc_wpun_channels filter"
msgstr "den Filter sc_wpun_channels"

#. translators: %d: Position of the entry in the list, starting at 1.
#, php-format
msgid "Channel %d repeats the id of an earlier channel and was skipped."
msgstr "Kanal %d wiederholt die ID eines früheren Kanals und wurde übersprungen."

#. translators: %d: Position of the entry in the list, starting at 1.
#, php-format
msgid "Channel %d is not valid and was skipped."
msgstr "Kanal %d ist ungültig und wurde übersprungen."

msgid "Some configuration values supplied from outside the database are not valid. Invalid settings fall back to the saved value; a channel with an invalid value does not send until it is fixed."
msgstr "Einige Konfigurationswerte, die von außerhalb der Datenbank kommen, sind ungültig. Für ungültige Einstellungen wird der gespeicherte Wert verwendet; ein Kanal mit einem ungültigen Wert sendet nichts, bis der Wert korrigiert ist."

msgid "WP Updates Notifier cannot use some configuration values"
msgstr "WP Updates Notifier kann einige Konfigurationswerte nicht verwenden"

msgid "Some values supplied by constants, environment variables or other sources are not valid. Invalid settings fall back to the saved value; a channel with an invalid value does not send until it is fixed."
msgstr "Einige Werte aus Konstanten, Umgebungsvariablen oder anderen Quellen sind ungültig. Für ungültige Einstellungen wird der gespeicherte Wert verwendet; ein Kanal mit einem ungültigen Wert sendet nichts, bis der Wert korrigiert ist."

msgid "Review the notification settings"
msgstr "Benachrichtigungseinstellungen überprüfen"

#. translators: Describes where a configuration value comes from; shown in "Set by %s". Keep sc_wpun_config_value as is.
msgid "the sc_wpun_config_value filter"
msgstr "den Filter sc_wpun_config_value"

msgid "The value is not valid for this setting, so the default is used."
msgstr "Der Wert ist für diese Einstellung ungültig, daher wird der Standardwert verwendet."

msgid "The value is not valid for this setting, so the saved one is used."
msgstr "Der Wert ist für diese Einstellung ungültig, daher wird der gespeicherte Wert verwendet."

msgid "The value is not valid for this field."
msgstr "Der Wert ist für dieses Feld ungültig."

msgid "The value is not a recognised on or off value (1, true, yes, on, 0, false, no, off), so environment variables are not read."
msgstr "Der Wert ist kein gültiger An/Aus-Wert (1, true, yes, on, 0, false, no, off), daher werden Umgebungsvariablen nicht gelesen."

msgid "Every entry must implement WPUN\\Config_Source."
msgstr "Jeder Eintrag muss WPUN\\Config_Source implementieren."

#. translators: Describes where a configuration value comes from; shown in "Set by %s".
msgid "a configuration source"
msgstr "eine Konfigurationsquelle"

#. translators: %s: Name of a PHP constant. Describes where a configuration value comes from; shown in "Set by %s".
#, php-format
msgid "constant %s"
