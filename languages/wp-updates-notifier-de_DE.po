msgid "Delete the channel %s? Its settings and delivery history are removed. This cannot be undone."
msgstr "Den Kanal %s löschen? Seine Einstellungen und sein Zustellverlauf werden entfernt. Dies kann nicht rückgängig gemacht werden."

msgid "No known item types"
msgstr "Keine bekannten Elementtypen"

msgid "All updates"
msgstr "Alle Aktualisierungen"

msgid "Never"
msgstr "Nie"

