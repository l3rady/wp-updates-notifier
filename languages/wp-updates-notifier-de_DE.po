msgstr "Kanal als %s dupliziert."

#. translators: %s: Label of the channel.
#, php-format
msgid "%s deleted."
msgstr "%s gelöscht."

msgid "Check for updates and notify now"
msgstr "Jetzt nach Aktualisierungen suchen und benachrichtigen"

#. translators: %s: Link to the Channels tab, with the text "Channels tab".
#, php-format
msgid "Only updates that were not notified yet are sent. To try a channel, send a test message from the %s."
msgstr "Es werden nur Aktualisierungen gesendet, über die noch nicht benachrichtigt wurde. Um einen Kanal auszuprobieren, sende eine Testnachricht im %s."

msgid "Channels tab"
msgstr "Tab „Kanäle“"

msgid "Checked just now. Nothing was sent because no channel is enabled."
msgstr "Gerade geprüft. Es wurde nichts gesendet, da kein Kanal aktiviert ist."

msgid "Checked just now. Nothing new to send."
msgstr "Gerade geprüft. Es gibt nichts Neues zu senden."

#. translators: %d: Number of channels the update was sent to.
#, php-format
