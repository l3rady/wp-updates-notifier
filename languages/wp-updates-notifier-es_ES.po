#, php-format
msgid "%s (no longer available)"
msgstr "%s (ya no está disponible)"

msgid "The saved frequency is no longer available on this site, so checks run at the interval they were last scheduled with. Choose a frequency and save to change it."
msgstr "La frecuencia guardada ya no está disponible en este sitio, así que las comprobaciones se ejecutan con el intervalo con el que se programaron por última vez. Elige una frecuencia y guarda para cambiarla."

#. translators: 1: The display asked for. 2: The display used instead.
#, php-format
msgid "The display \"%1$s\" cannot show an on or off value, so \"%2$s\" is used."
msgstr "La visualización \"%1$s\" no puede mostrar un valor de activado o desactivado, así que se usa \"%2$s\"."

msgid "Yes"
msgstr "Sí"

msgid "No"
msgstr "No"

msgid "A channel type may only contain lower case letters, digits and underscores."
msgstr "Un tipo de canal solo puede contener letras minúsculas, números y guiones bajos."

#. translators: %s: Channel type.
#, php-format
msgid "A channel of type \"%s\" is already registered."
msgstr "Ya hay registrado un canal del tipo \"%s\"."

