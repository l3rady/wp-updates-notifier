msgstr "Las constantes de este canal empiezan por %s"

msgid "Updates already waiting"
msgstr "Actualizaciones ya pendientes"

msgid "Don't send the updates that are already waiting"
msgstr "No enviar las actualizaciones que ya están pendientes"

msgid "Only updates that appear after the channel is switched on are sent. Applies when the channel is saved switched on."
msgstr "Solo se envían las actualizaciones que aparezcan después de activar el canal. Se aplica cuando el canal se guarda activado."

msgid "Routing"
msgstr "Enrutamiento"

msgid "On the General tab, plugins are not checked."
msgstr "En la pestaña General, no se comprueban los plugins."

#. translators: "All" and "Only active ones" are routing choices on this form: use the same translations as for those choices.
msgid "On the General tab, only active plugins are checked, so \"All\" here acts like \"Only active ones\" for plugins."
msgstr "En la pestaña General solo se comprueban los plugins activos, así que aquí \"Todos\" equivale a \"Solo los activos\" para los plugins."

msgid "On the General tab, themes are not checked."
msgstr "En la pestaña General, no se comprueban los temas."

#. translators: "All" and "Only active ones" are routing choices on this form: use the same translations as for those choices.
msgid "On the General tab, only active themes are checked, so \"All\" here acts like \"Only active ones\" for themes."
msgstr "En la pestaña General solo se comprueban los temas activos, así que aquí \"Todos\" equivale a \"Solo los activos\" para los temas."

msgid "On the General tab, WordPress updates are not checked."
msgstr "En la pestaña General, no se comprueban las actualizaciones de WordPress."

msgid "On the General tab, only major releases are checked."
msgstr "En la pestaña General solo se comprueban las versiones principales."

