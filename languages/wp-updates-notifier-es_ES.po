#, php-format
msgid "Its API requirement \"%s\" could not be read."
msgstr "No se ha podido leer su requisito de API \"%s\"."

msgid "An instance defined in code cannot be saved."
msgstr "Una instancia definida en el código no se puede guardar."

msgid "An instance defined in code cannot be deleted."
msgstr "Una instancia definida en el código no se puede borrar."

#. translators: 1: Channel type. 2: Field name.
#, php-format
msgid "The field \"%2$s\" of the \"%1$s\" channel cannot be supplied from outside the database: the name \"enabled\" is reserved, and names may only contain a-z, 0-9 and single underscores."
msgstr "El campo \"%2$s\" del canal \"%1$s\" no se puede proporcionar desde fuera de la base de datos: el nombre \"enabled\" está reservado y los nombres solo pueden contener a-z, 0-9 y guiones bajos sueltos."

msgid "The value is not valid for this channel."
msgstr "El valor no es válido para este canal."

#. translators: %s: Class name of an exception.
#, php-format
msgid "The value could not be checked: %s was thrown."
msgstr "No se ha podido comprobar el valor: se ha lanzado %s."

