#, php-format
msgid "Needs WP Updates Notifier API %1$s; this site has %2$s. Update WP Updates Notifier."
msgstr "Necesita la API de WP Updates Notifier %1$s; este sitio tiene la %2$s. Actualiza WP Updates Notifier."

