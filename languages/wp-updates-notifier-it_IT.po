msgstr "Ultimo controllo: %s"

msgid "Next check: not scheduled. Save the settings to schedule it."
msgstr "Prossimo controllo: non pianificato. Salva le impostazioni per pianificarlo."

#. translators: %s: Date and time of the next check.
#, php-format
msgid "Next check: %s"
msgstr "Prossimo controllo: %s"

