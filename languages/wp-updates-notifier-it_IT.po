#, php-format
msgid "%s is defined in code and cannot be changed here."
msgstr "%s è definito nel codice e non può essere modificato qui."

msgid "Save channel"
msgstr "Salva canale"

msgid "There is a problem"
msgstr "C'è un problema"

msgid "The channel was not saved. Please correct the following."
msgstr "Il canale non è stato salvato. Correggi quanto segue."

