#, php-format
msgid "%1$s at %2$s"
msgstr "%1$s alle %2$s"

msgid "Choose how often to check for updates."
msgstr "Scegli con quale frequenza controllare gli aggiornamenti."

msgid "Choose whether to be told about WordPress updates."
msgstr "Scegli se ricevere avvisi sugli aggiornamenti di WordPress."

msgid "Choose whether to be told about plugin updates."
msgstr "Scegli se ricevere avvisi sugli aggiornamenti dei plugin."

msgid "Choose whether to be told about theme updates."
msgstr "Scegli se ricevere avvisi sugli aggiornamenti dei temi."

msgid "Choose whether to hide the update notices."
msgstr "Scegli se nascondere gli avvisi di aggiornamento."

#. translators: %s: Label of the setting.
#, php-format
msgid "Choose a value for %s."
msgstr "Scegli un valore per %s."

msgid "This is a test message from WP Updates Notifier."
msgstr "Questo è un messaggio di prova di WP Updates Notifier."

#. translators: %s: Name of the saved schedule.
#, php-format
msgid "%s (no longer available)"
msgstr "%s (non più disponibile)"

msgid "The saved frequency is no longer available on this site, so checks run at the interval they were last scheduled with. Choose a frequency and save to change it."
msgstr "La frequenza salvata non è più disponibile su questo sito, quindi i controlli vengono eseguiti all'intervallo con cui sono stati pianificati l'ultima volta. Scegli una frequenza e salva per cambiarla."

#. translators: 1: The display asked for. 2: The display used instead.
#, php-format
msgid "The display \"%1$s\" cannot show an on or off value, so \"%2$s\" is used."
msgstr "La visualizzazione \"%1$s\" non può mostrare un valore attivo o disattivo, quindi viene usata \"%2$s\"."

msgid "Yes"
msgstr "Sì"

msgid "No"
msgstr "No"

msgid "A channel type may only contain lower case letters, digits and underscores."
msgstr "Un tipo di canale può contenere solo lettere minuscole, cifre e trattini bassi."

#. translators: %s: Channel type.
#, php-format
msgid "A channel of type \"%s\" is already registered."
msgstr "Un canale di tipo \"%s\" è già registrato."

#. translators: 1: The API version constraint the module needs, 2: The API version of this site.
#, php-format
msgid "Needs WP Updates Notifier API %1$s; this site has %2$s. Update WP Updates Notifier."
msgstr "Richiede l'API di WP Updates Notifier %1$s; questo sito ha la %2$s. Aggiorna WP Updates Notifier."

#. translators: %s: The API version constraint the module declared.
#, php-format
msgid "Its API requirement \"%s\" could not be read."
msgstr "Non è stato possibile leggere il suo requisito API \"%s\"."

msgid "An instance defined in code cannot be saved."
msgstr "Un'istanza definita nel codice non può essere salvata."

msgid "An instance defined in code cannot be deleted."
msgstr "Un'istanza definita nel codice non può essere eliminata."

#. translators: 1: Channel type. 2: Field name.
#, php-format
msgid "The field \"%2$s\" of the \"%1$s\" channel cannot be supplied from outside the database: the name \"enabled\" is reserved, and names may only contain a-z, 0-9 and single underscores."
msgstr "Il campo \"%2$s\" del canale \"%1$s\" non può essere fornito dall'esterno del database: il nome \"enabled\" è riservato e i nomi possono contenere solo a-z, 0-9 e trattini bassi singoli."

msgid "The value is not valid for this channel."
msgstr "Il valore non è valido per questo canale."

#. translators: %s: Class name of an exception.
#, php-format
msgid "The value could not be checked: %s was thrown."
msgstr "Non è stato possibile verificare il valore: è stata generata un'eccezione %s."

#. translators: Describes where a configuration value comes from; shown in "Set by %s". Keep SC_WPUN_CHANNELS as is.
msgid "constant SC_WPUN_CHANNELS"
msgstr "la costante SC_WPUN_CHANNELS"

msgid "The constant must be a JSON string."
msgstr "La costante deve essere una stringa JSON."

msgid "The value must be a JSON string."
msgstr "Il valore deve essere una stringa JSON."

msgid "The JSON must be a list of channels."
msgstr "Il JSON deve essere un elenco di canali."

#. translators: Describes where a configuration value comes from; shown in "Set by %s". Keep sc_wpun_channels as is.
msgid "the sc_wpun_channels filter"
msgstr "il filtro sc_wpun_channels"

#. translators: %d: Position of the entry in the list, starting at 1.
#, php-format
msgid "Channel %d repeats the id of an earlier channel and was skipped."
msgstr "Il canale %d ripete l'ID di un canale precedente ed è stato saltato."

#. translators: %d: Position of the entry in the list, starting at 1.
#, php-format
msgid "Channel %d is not valid and was skipped."
msgstr "Il canale %d non è valido ed è stato saltato."

msgid "Some configuration values supplied from outside the database are not valid. Invalid settings fall back to the saved value; a channel with an invalid value does not send until it is fixed."
msgstr "Alcuni valori di configurazione forniti dall'esterno del database non sono validi. Le impostazioni non valide tornano al valore salvato; un canale con un valore non valido non invia nulla finché non viene corretto."

msgid "WP Updates Notifier cannot use some configuration values"
msgstr "WP Updates Notifier non può usare alcuni valori di configurazione"

msgid "Some values supplied by constants, environment variables or other sources are not valid. Invalid settings fall back to the saved value; a channel with an invalid value does not send until it is fixed."
msgstr "Alcuni valori forniti da costanti, variabili d'ambiente o altre fonti non sono validi. Le impostazioni non valide tornano al valore salvato; un canale con un valore non valido non invia nulla finché non viene corretto."

msgid "Review the notification settings"
msgstr "Controlla le impostazioni delle notifiche"

#. translators: Describes where a configuration value comes from; shown in "Set by %s". Keep sc_wpun_config_value as is.
msgid "the sc_wpun_config_value filter"
msgstr "il filtro sc_wpun_config_value"

msgid "The value is not valid for this setting, so the default is used."
msgstr "Il valore non è valido per questa impostazione, quindi viene usato quello predefinito."

msgid "The value is not valid for this setting, so the saved one is used."
msgstr "Il valore non è valido per questa impostazione, quindi viene usato quello salvato."

msgid "The value is not valid for this field."
msgstr "Il valore non è valido per questo campo."

msgid "The value is not a recognised on or off value (1, true, yes, on, 0, false, no, off), so environment variables are not read."
msgstr "Il valore non è un valore di attivazione o disattivazione riconosciuto (1, true, yes, on, 0, false, no, off), quindi le variabili d'ambiente non vengono lette."

msgid "Every entry must implement WPUN\\Config_Source."
msgstr "Ogni voce deve implementare WPUN\\Config_Source."

#. translators: Describes where a configuration value comes from; shown in "Set by %s".
msgid "a configuration source"
msgstr "una fonte di configurazione"

#. translators: %s: Name of a PHP constant. Describes where a configuration value comes from; shown in "Set by %s".
#, php-format
msgid "constant %s"
msgstr "la costante %s"

msgid "This channel is switched off."
msgstr "Questo canale è disattivato."

#. translators: %s: Channel type.
#, php-format
msgid "The \"%s\" channel did not return a Delivery_Result."
msgstr "Il canale \"%s\" non ha restituito un Delivery_Result."

#. translators: %s: Channel type.
#, php-format
msgid "The \"%s\" channel failed with an error."
msgstr "Il canale \"%s\" non è riuscito a causa di un errore."

#. translators: %s: Names of the constants or environment variables that are not valid.
