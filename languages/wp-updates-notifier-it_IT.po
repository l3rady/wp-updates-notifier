#, php-format
msgid "Set by %s"
msgstr "Impostato tramite %s"

msgid "Channel"
msgstr "Canale"

msgid "ID"
msgstr "ID"

msgid "The id is made from the label when the channel is saved and cannot be changed afterwards."
msgstr "L'ID viene creato dall'etichetta quando il canale viene salvato e non può essere modificato in seguito."

#. translators: %s: Start of the names of the constants, for example "SC_WPUN_CHANNEL_EMAIL__".
#, php-format
msgid "Constants for this channel start with %s"
msgstr "Le costanti di questo canale iniziano con %s"

msgid "Updates already waiting"
msgstr "Aggiornamenti già in attesa"

msgid "Don't send the updates that are already waiting"
msgstr "Non inviare gli aggiornamenti già in attesa"

msgid "Only updates that appear after the channel is switched on are sent. Applies when the channel is saved switched on."
msgstr "Vengono inviati solo gli aggiornamenti che compaiono dopo l'attivazione del canale. Si applica quando il canale viene salvato attivo."

msgid "Routing"
msgstr "Instradamento"

msgid "On the General tab, plugins are not checked."
msgstr "Nella scheda Generale, i plugin non vengono controllati."

#. translators: "All" and "Only active ones" are routing choices on this form: use the same translations as for those choices.
msgid "On the General tab, only active plugins are checked, so \"All\" here acts like \"Only active ones\" for plugins."
msgstr "Nella scheda Generale vengono controllati solo i plugin attivi, quindi qui \"Tutti\" equivale a \"Solo quelli attivi\" per i plugin."

msgid "On the General tab, themes are not checked."
msgstr "Nella scheda Generale, i temi non vengono controllati."

#. translators: "All" and "Only active ones" are routing choices on this form: use the same translations as for those choices.
msgid "On the General tab, only active themes are checked, so \"All\" here acts like \"Only active ones\" for themes."
msgstr "Nella scheda Generale vengono controllati solo i temi attivi, quindi qui \"Tutti\" equivale a \"Solo quelli attivi\" per i temi."

msgid "On the General tab, WordPress updates are not checked."
msgstr "Nella scheda Generale, gli aggiornamenti di WordPress non vengono controllati."

msgid "On the General tab, only major releases are checked."
msgstr "Nella scheda Generale vengono controllate solo le versioni principali."

